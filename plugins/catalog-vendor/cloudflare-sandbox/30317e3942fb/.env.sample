# Add these values to the environment of the Duckwork process (or its profile .env).
DUCKWORK_CF_ENDPOINT=https://your-worker.your-subdomain.workers.dev
# Generate a new random secret and set the SAME value as the Worker secret SANDBOX_API_TOKEN.
DUCKWORK_CF_TOKEN=
# Optional stable identities. Pick a different namespace per user/profile.
DUCKWORK_CF_NAMESPACE=personal
# Leave this unset for per-task workspaces. Set it to resume one project across task IDs.
# Do not share one named workspace between simultaneously running Duckwork processes.
# DUCKWORK_CF_WORKSPACE=my-project
DUCKWORK_CF_IMAGE=duckwork
# Must be in the Worker's ALLOWED_INSTANCE_TYPES. Unset uses the Worker's default.
# DUCKWORK_CF_INSTANCE=standard-1
# Optional Cloudflare Access service token; these fields must be set together.
# DUCKWORK_CF_ACCESS_CLIENT_ID=
# DUCKWORK_CF_ACCESS_CLIENT_SECRET=
