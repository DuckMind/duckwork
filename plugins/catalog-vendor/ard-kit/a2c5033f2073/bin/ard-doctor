#!/bin/sh
# Plugin entry point. PYTHONPATH keeps -m working from any cwd.
# The interpreter is resolved, never hardcoded: Windows Python ships as
# python/py, so a literal python3 turned every wrapper into a trap that
# `command -v` still reported as available.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$(command -v python3 || command -v python || command -v py)"
if [ -z "$PY" ]; then
    echo "ard-kit: no Python interpreter on PATH (tried python3, python, py)" >&2
    exit 127
fi
exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m ard_kit.doctor "$@"
